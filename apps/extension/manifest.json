{
  "manifest_version": 3,
  "name": "Provenance Inspector",
  "version": "0.1.0",
  "description": "Inspect selected web content for verifiable provenance signals, and report only what the evidence supports.",
  "minimum_chrome_version": "116",
  "permissions": [
    "contextMenus",
    "sidePanel",
    "scripting",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
